# ── Step 1: Change password to YOUR PostgreSQL password ──────────────────────
# Use 127.0.0.1 instead of localhost (avoids DNS issues on Windows)
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@127.0.0.1:5432/resumeiq

# ── Step 2: JWT Secret — any long random string ───────────────────────────────
SECRET_KEY=resumeiq-jwt-secret-key-2025-make-this-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Step 3: AI (optional — works in mock mode without this) ──────────────────
# Get free key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Step 4: Frontend URL for CORS ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
